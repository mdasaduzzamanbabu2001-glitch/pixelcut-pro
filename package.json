{
  "name": "pixelcut-pro",
  "productName": "Pixelcut Pro Tool",
  "version": "1.0.2",
  "updateNotes": "🚀 নতুন আপডেট সফলভাবে কাজ করছে!",
  "updateRepoUrl": "https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_REPO_NAME/main",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.pixelcut.pro",
    "productName": "Pixelcut Pro Tool",
    "asar": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  }
}
